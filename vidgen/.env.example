# Copy this file to .env and fill in the keys you have.
# Every key is optional; the app tells you what each missing one disables.

# Writes the script from your idea. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voiceover with word-accurate captions. Free tier available. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Any voice ID from https://elevenlabs.io/app/voice-library (default: "Rachel")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Free stock video footage. https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional settings
PORT=3000
# Where finished videos are saved
OUTPUT_DIR=output
# Use your own ffmpeg instead of the bundled one
# FFMPEG_PATH=/usr/local/bin/ffmpeg
